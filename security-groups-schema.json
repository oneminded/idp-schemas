{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/oneminded/idp-schemas/refs/heads/main/security-groups-schema.json",
    "title": "Security Groups Schema",
    "description": "Schema for defining security groups configuration",
    "type": "object",
    "required": ["values"],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to the JSON schema"
        },
        "values": {
            "type": "array",
            "description": "Array of security group definitions",
            "items": {
                "type": "object",
                "required": ["displayName", "mailNickName", "description"],
                "properties": {
                    "displayName": {
                        "type": "string",
                        "description": "Display name of the security group",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "mailNickName": {
                        "type": "string",
                        "description": "Mail nickname for the security group (must be unique and follow naming conventions)",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9-]+$"
                    },
                    "description": {
                        "type": "string",
                        "description": "Description of the security group's purpose",
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "additionalProperties": false
            },
            "minItems": 1
        }
    },
    "additionalProperties": false
}
