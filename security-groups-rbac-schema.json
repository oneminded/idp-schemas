{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/oneminded/idp-schemas/refs/heads/main/security-groups-rbac-schema.json",
    "title": "Security Groups with optional RBAC Schema",
    "description": "Schema for defining security groups with Azure role assignments configuration",
    "type": "object",
    "required": ["values"],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to the JSON schema"
        },
        "values": {
            "type": "array",
            "description": "Array of security group definitions with optional role assignments",
            "items": {
                "type": "object",
                "required": ["displayName", "mailNickName", "description"],
                "properties": {
                    "displayName": {
                        "type": "string",
                        "description": "Display name of the security group",
                        "minLength": 1,
                        "maxLength": 256
                    },
                    "mailNickName": {
                        "type": "string",
                        "description": "Mail nickname for the security group (must be unique and follow naming conventions)",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9-]+$"
                    },
                    "description": {
                        "type": "string",
                        "description": "Description of the security group's purpose",
                        "minLength": 1,
                        "maxLength": 1024
                    },
                    "roleAssignments": {
                        "type": "array",
                        "description": "Optional array of Azure role assignments to be applied to this security group",
                        "items": {
                            "type": "object",
                            "required": ["role", "scope"],
                            "properties": {
                                "role": {
                                    "type": "string",
                                    "description": "The name of the Azure built-in or custom role to assign",
                                    "minLength": 1,
                                    "maxLength": 256,
                                    "examples": [
                                        "Reader",
                                        "Contributor",
                                        "Owner",
                                        "Storage Blob Data Contributor"
                                    ]
                                },
                                "scope": {
                                    "type": "string",
                                    "description": "The scope at which the role assignment applies (subscription, resource group, or resource level)",
                                    "minLength": 1,
                                    "examples": [
                                        "/subscriptions/00000000-0000-0000-0000-000000000000",
                                        "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example",
                                        "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-example/providers/Microsoft.Storage/storageAccounts/stexample"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        },
                        "minItems": 1
                    }
                },
                "additionalProperties": false
            },
            "minItems": 1
        }
    },
    "additionalProperties": false
}
