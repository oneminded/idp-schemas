{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/oneminded/idp-schemas/refs/heads/main/app-role-assignments-schema.json",
    "title": "App Role Assignments Schema",
    "description": "Schema for defining application role assignments configuration",
    "type": "object",
    "required": ["values"],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Reference to the JSON schema"
        },
        "values": {
            "type": "array",
            "description": "Array of app role assignment definitions",
            "items": {
                "type": "object",
                "required": ["resourceId", "principalId", "appRoleId"],
                "properties": {
                    "resourceId": {
                        "type": "string",
                        "description": "The Object ID (GUID) of the service principal associated with the application. Accepts a GUID or a placeholder token (e.g. ${ResourceId}).",
                        "examples": [
                            "00000000-0000-0000-0000-000000000000",
                            "${ResourceId}"
                        ]
                    },
                    "principalId": {
                        "type": "string",
                        "description": "The Object ID (GUID) of the user, group, or service principal to assign the role to. Accepts a GUID or a placeholder token (e.g. ${PrincipalId}).",
                        "examples": [
                            "00000000-0000-0000-0000-000000000000",
                            "${PrincipalId}"
                        ]
                    },
                    "appRoleId": {
                        "type": "string",
                        "description": "The ID (GUID) of the app role to assign to the principal. Accepts a GUID or a placeholder token (e.g. ${AppRoleId}).",
                        "examples": [
                            "00000000-0000-0000-0000-000000000000",
                            "${AppRoleId}"
                        ]
                    }
                },
                "additionalProperties": false
            },
            "minItems": 1
        }
    },
    "additionalProperties": false
}
